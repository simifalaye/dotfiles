#!/usr/bin/env bash
#
# Provisions dev machine and deploys dotfiles
#
# Optional env:
# - LOG_LEVEL: 7 = debug -> 0 = emergency
# - NO_COLOR: 1 = disable color
# - DRY_RUN: 1 = don't do anything
# - UNINSTALL: 1 = uinstall dotfiles
#
# Usage: ./install <module>

MODULE=""

# Load common libs (sets LOG_LEVEL, NO_COLOR, DRY_RUN)
source "./lib/common"

function run_module() {
  if [ -z "${MODULE}" ] || [ "${1}" = "${MODULE}" ]; then
    # shellcheck source=/dev/null
    source "./modules/${1}/install"
  fi
}

#-
#  Main
#-

MODULE="${1}"

# Required for modules scripts
# shellcheck disable=SC2034
COMMON_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common"

# Update system package manager
update_pkg_manager 72

# Cleanup home
info "Cleaning up HOME of misc files"
remove_list=(
  "$HOME/.lesshst"
  "$HOME/.lesskey"
  "$HOME/.viminfo"
  "$HOME/.tig_history"
  "$HOME/.calc_history"
  "$HOME/.zcompdump"
)
for file in "${remove_list[@]}"; do
  [ -e "$file" ] && _run rm -f "$file"
done

# Run modules that are depended on by others
run_module shell
run_module git
run_module homebrew
run_module node
run_module python

# Run modules that have no order requirements
run_module alacritty
run_module atool
run_module bat
run_module calc
run_module coreutils
run_module delta
run_module direnv
run_module elinks
run_module eza
run_module fd
run_module fzf
run_module github
run_module golang
run_module htop
run_module hyperkey
run_module jq
run_module nerd-fonts
run_module neovim
run_module os-theme-watcher
run_module ripgrep
run_module rsync
run_module rust
run_module scroll-reverser
run_module tig
run_module tmux
run_module trash
run_module unison
run_module wezterm
run_module win32yank
run_module zoxide
